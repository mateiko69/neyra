# Copy to .env and fill values. Do NOT commit real secrets.

ENV=development

# === OAuth / Social login ===
# Production guidance:
# - Enable provider flag and configure the provider's callback/redirect URL to your frontend.
# - Never expose secrets to the frontend (NEXT_PUBLIC_*).

# Google OAuth
ENABLE_GOOGLE_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must point to the backend callback route:
#   ${PUBLIC_BACKEND_URL}/api/v1/auth/social/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Apple Sign-In
ENABLE_APPLE_OAUTH=false
APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Multiline private keys should be stored with \n escapes or mounted as a file.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# Facebook Login
ENABLE_FACEBOOK_OAUTH=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# Dev-only: enable mock social login endpoints (never enable in production)
AUTH_DEV_SOCIAL=false

APP_NAME=NEYRA
ENV=development
SECRET_KEY=__GENERATE_STRONG_SECRET_KEY__
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql://postgres:postgres@db:5432/neyra
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com

# Social sign-in (enable per provider; Google client id is public; Apple uses Services ID as client id)
ENABLE_GOOGLE_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=
ENABLE_APPLE_OAUTH=false
APPLE_OAUTH_CLIENT_ID=
ENABLE_FACEBOOK_OAUTH=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Apple Sign In: add each web return URL you use (e.g. http://localhost:3000/login, http://localhost:3000/signup) in Apple Developer → Services ID → Web Authentication.
# Google (GIS ID token flow):
# - Create an OAuth Client ID (Web application) in Google Cloud Console.
# - Add Authorized JavaScript origins (e.g. http://localhost:3000) for the same client id.
# - Set GOOGLE_OAUTH_CLIENT_ID to that *web client id* (public).
# Note: the backend validates ID tokens against GOOGLE_OAUTH_CLIENT_ID.

# Feature flags
ENABLE_AI_SUGGESTIONS=true
ENABLE_ADVANCED_MATCHING=true
ENABLE_PREMIUM_FEATURES=true
DEMO_MODE=false
# AI demo showcase: only `is_demo` catalog users in Discover/Matches. Dev/staging default is ON; production default OFF unless you set it.
# Use DEMO_PREMIUM_ONLY_MODE=false to mix real profiles when testing locally.
DEMO_PREMIUM_ONLY_MODE=
AI_STRICT_MONETIZATION=true
DEV_FORCE_PREMIUM=false
# Living demo (delayed demo replies): requires demo mode + admin "live behavior" on. Default off in prod.
DEMO_LIVE_BEHAVIOR=false

AI_PROVIDER=mock
OPENAI_API_KEY=
# Get a key in Google AI Studio / Google Cloud and keep it server-side only.
GEMINI_API_KEY=
# Gemini model (v1 generateContent). Only gemini-2.5-flash-lite is used regardless of env (stable routing).
GEMINI_MODEL=gemini-2.5-flash-lite
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=450
AI_TEMPERATURE=0.85
AI_CACHE_TTL_SECONDS=3600
AI_CALLS_PER_MINUTE_FREE=6
AI_CALLS_PER_DAY_FREE=40
AI_CALLS_PER_MINUTE_PREMIUM=30
AI_CALLS_PER_DAY_PREMIUM=400

STORAGE_PROVIDER=local
# Filesystem path inside the container for persisted uploads.
# WARNING: on Railway, local container storage is ephemeral across restarts/deploys.
# Use STORAGE_PROVIDER=s3 in production for durable profile and verification photos.
UPLOAD_DIR=/app/uploads
# Public URL prefix served by FastAPI StaticFiles.
UPLOAD_PUBLIC_PREFIX=/uploads
# Legacy (still supported): LOCAL_UPLOAD_DIR=uploads
# Full origin serving the API + static /uploads (browser must reach this).
PUBLIC_BACKEND_URL=http://localhost:8000
S3_BUCKET=
# Cloudflare R2: set S3_ENDPOINT_URL to the R2 S3 API endpoint; S3_REGION=auto is common.
S3_REGION=
S3_ENDPOINT_URL=
# Public origin for objects (R2 public bucket URL, R2 custom domain, or CloudFront). No trailing slash.
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paddle Billing — webhook HMAC secret (Dashboard → Developer tools → Notifications). Required in production.
PADDLE_WEBHOOK_SECRET=

PUSH_PROVIDER=mock
FIREBASE_CREDENTIALS_JSON=

RATE_LIMIT_PER_MINUTE=60
# Set to false only for local load testing (disables IP rate limiting entirely).
RATE_LIMIT_ENABLED=true
# Use ENV=production in deployed environments so dev-only rate-limit relaxations are off.
QUEUE_NAME=app_events

# =============================================================================
# Production (Railway) — minimal checklist (never commit secrets)
# =============================================================================
# ENV=production
# DATABASE_URL=<Railway Postgres connection string>
# REDIS_URL=<Railway Redis connection string / leave empty only if intentionally disabled>
#
# PUBLIC_BACKEND_URL=https://YOUR-PROJECT.up.railway.app
# PUBLIC_FRONTEND_URL=https://getneyra.app
# APP_PUBLIC_URL=https://getneyra.app
# FRONTEND_URL=https://getneyra.app
#
# Browser CORS — comma-separated origins (code also always merges getneyra + www defaults):
# CORS_ORIGINS=https://getneyra.app,https://www.getneyra.app
# CORS_ALLOW_VERCEL_PREVIEWS=true
#
# GEMINI_API_KEY=<secret>
#
# Telegram worker (Railway secondary service → same Dockerfile, separate start command):
# TELEGRAM_BOT_TOKEN=<secret>
# ADMIN_TELEGRAM_IDS=123456789,987654321
# TELEGRAM_ADMIN_IDS=123456789
# (TELEGRAM_ADMIN_IDS is an alias — prefer ADMIN_TELEGRAM_IDS.)
# ADMIN_BOT_SERVICE_TOKEN=<long random secret>
# BACKEND_BASE_URL=https://YOUR-PROJECT.up.railway.app
#
# Google OAuth (backend verifies tokens + callback):
# ENABLE_GOOGLE_OAUTH=true
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-PUBLIC-BACKEND-ORIGIN/api/v1/auth/social/google/callback
#
