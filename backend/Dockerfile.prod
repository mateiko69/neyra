FROM python:3.12-slim

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONPATH=/app
ENV ENV=production

EXPOSE 8000

# Production: no auto-seed, no reload. Railway sets PORT; default 8000 for local image runs.
RUN chmod +x /app/scripts/start_web_production.sh
CMD ["sh", "-c", "/app/scripts/start_web_production.sh"]

