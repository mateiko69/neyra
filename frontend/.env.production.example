# Production environment variables for NEYRA web on Vercel.
# Copy into Vercel Project → Settings → Environment Variables (Production + Preview).

# -----------------------------------------------------------------------------
# Backend API origin (scheme + host, no trailing slash, no /api/v1 path)
# Set this to your Railway (or other) HTTPS API URL:
#   https://YOUR-PROJECT.up.railway.app
# Or a custom domain with TLS:
#   https://api.getneyra.app
#
# Prefer NEXT_PUBLIC_API_BASE_URL (canonical). NEXT_PUBLIC_BACKEND_URL is equivalent.
NEXT_PUBLIC_API_BASE_URL=https://api.getneyra.app
# NEXT_PUBLIC_BACKEND_URL=https://api.getneyra.app

# Paddle (client-safe tokens / price IDs from Paddle Billing)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_NEYRA_PREMIUM_PRICE_ID=
NEXT_PUBLIC_NEYRA_PREMIUM_PLUS_PRICE_ID=

# Optional: Daily.co iframe domain only (no scheme)
NEXT_PUBLIC_DAILY_DOMAIN=

# Debug features MUST stay disabled in production:
NEXT_PUBLIC_AI_DEBUG=false
NEXT_PUBLIC_AI_FORCE_UI=false
# NEXT_PUBLIC_DEBUG_API=0

# -----------------------------------------------------------------------------
# OAuth / Auth.js (NEXTAUTH_*)
#
# NEYRA’s web login today uses backend Google OAuth (GIS + backend callbacks). If you
# add Auth.js later, configure:
#
# NEXTAUTH_URL=https://getneyra.app
# NEXTAUTH_SECRET=<generate with openssl rand -base64 32>
#
# Backend must have matching Google OAuth client (see DEPLOYMENT.md and backend/.env.example).
